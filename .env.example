NODE_ENV=development
APP_HOST=127.0.0.1
APP_PORT=3000

# PostgreSQL connection used by the API.
DATABASE_URL=postgresql://handcraft:change-me@localhost:55432/handcraft

SESSION_SECRET=replace-with-at-least-32-random-characters
COOKIE_SECURE=false
PUBLIC_APP_URL=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760

# 结余调整差异阈值（比例，0-1）。调整数量 / 调整前结余超过该值时暂存待第二位操作员复核。
# 0 = 所有调整都需复核；默认 0.1 = 调整幅度超过结余 10% 需复核；调整前结余为 0 时一律需复核。
ADJUSTMENT_REVIEW_THRESHOLD_RATIO=0.1

LOG_LEVEL=info
TZ=Asia/Shanghai
